;; jolt-tcp — a teensyp-compatible TCP server for jolt (Clojure on Chez Scheme).
;; No JVM, no NIO: a single jolt.net readiness reactor plus bounded handler and
;; callback executors. Mirrors the teensyp.* namespaces so teensyp handlers run
;; unmodified. Run tests with the reviewed fork compiler.
{:paths ["src"]

 :deps {io.github.casselc/jolt-net
        {:git/url "https://github.com/casselc/jolt-net.git"
         :git/sha "a4a4deb6b757d5e86aeb941cf646927e21420df6"}}

 ;; jolt-hegel is test-time only (property/stateful generation via libhegel), so
 ;; it lives in :extra-deps rather than :deps. Because the dep is alias-scoped,
 ;; the installer needs the alias too: `joltc -A:test -m hegel.install`.
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.chucklehead-dev/jolt-hegel
                               {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                                :git/sha "e03127174bcaea4ffa1c0cef11bde0efa009e9dc"}}
                  :main-opts ["-m" "teensyp.server-test"]}
           ;; Checked-in mains avoid joltc's currently POSIX-only stdin path on
           ;; native Windows while keeping each source-mode claim explicit.
           ;;
           ;; The runtime gate deliberately declares no :extra-deps. Real
           ;; Windows socket coverage must not be able to disappear because an
           ;; optional test dependency failed to resolve or install; the
           ;; Hegel-required suite is the separate :test lane.
           :windows-runtime-test
           {:extra-paths ["test"]
            :main-opts ["-m" "teensyp.windows-runtime-test"]}
           :windows-buffer-property-test
           {:extra-paths ["test"]
            :extra-deps {io.github.chucklehead-dev/jolt-hegel
                         {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                          :git/sha "e03127174bcaea4ffa1c0cef11bde0efa009e9dc"}}
            :main-opts ["-m" "teensyp.windows-buffer-property-test"]}
           :windows-arm64-preview
           {:extra-paths ["test"]
            :extra-deps {io.github.chucklehead-dev/jolt-hegel
                         {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
                          :git/sha "e03127174bcaea4ffa1c0cef11bde0efa009e9dc"}}
            :main-opts ["-m" "teensyp.windows-arm64-preview"]}}

 :tasks {test "joltc -M:test"}}
